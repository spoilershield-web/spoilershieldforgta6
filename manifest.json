{
  "manifest_version": 3,
  "name": "Spoiler Shield for GTA 6 (Unofficial Fan Tool)",
  "version": "1.7.3",
  "description": "Blurs and hides GTA 6 spoilers across YouTube, X, Reddit and more locally in your browser. Zero tracking. Unofficial fan tool.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://news.google.com/*",
        "https://www.twitch.tv/*",
        "https://kick.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.threads.net/*",
        "https://www.ign.com/*",
        "https://www.gamespot.com/*",
        "https://kotaku.com/*",
        "https://www.pcgamer.com/*",
        "https://www.eurogamer.net/*"
      ],
      "exclude_matches": [
        "https://x.com/messages*",
        "https://x.com/i/flow/*",
        "https://x.com/settings*",
        "https://twitter.com/messages*",
        "https://twitter.com/i/flow/*",
        "https://twitter.com/settings*",
        "https://www.instagram.com/direct/*",
        "https://www.instagram.com/accounts/*",
        "https://www.facebook.com/messages/*",
        "https://www.facebook.com/login*",
        "https://www.reddit.com/chat*",
        "https://www.reddit.com/message/*",
        "https://www.reddit.com/login*",
        "https://www.reddit.com/register*",
        "https://www.twitch.tv/settings*",
        "https://www.tiktok.com/messages*",
        "https://www.tiktok.com/login*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}